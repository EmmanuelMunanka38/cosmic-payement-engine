# AfriPay Gateway — Environment Variables

# --- App ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# --- Database ---
DATABASE_URL="postgresql://afripay:afripay@localhost:5432/afripay?schema=public"

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- JWT ---
JWT_SECRET=change-me-to-a-random-32-char-string-minimum
JWT_REFRESH_SECRET=change-me-to-another-random-32-char-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- Stripe (abstracted behind CardProvider interface) ---
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
STRIPE_CONNECT_CLIENT_ID=ca_xxxxxxxxxxxxxxxxxxxx

# --- M-Pesa (Daraja API) ---
MPESA_CONSUMER_KEY=xxxxxxxxxxxxxxxx
MPESA_CONSUMER_SECRET=xxxxxxxxxxxxxxxx
MPESA_PASSKEY=xxxxxxxxxxxxxxxx
MPESA_SHORTCODE=174379
MPESA_ENVIRONMENT=sandbox

# --- MTN MoMo ---
MTN_MOMO_API_KEY=xxxxxxxxxxxxxxxx
MTN_MOMO_API_SECRET=xxxxxxxxxxxxxxxx
MTN_MOMO_SUBSCRIPTION_KEY=xxxxxxxxxxxxxxxx
MTN_MOMO_ENVIRONMENT=sandbox
MTN_MOMO_COLLECTION_PRIMARY_KEY=xxxxxxxxxxxxxxxx
MTN_MOMO_DISBURSEMENT_PRIMARY_KEY=xxxxxxxxxxxxxxxx

# --- Airtel Money ---
AIRTEL_CLIENT_ID=xxxxxxxxxxxxxxxx
AIRTEL_CLIENT_SECRET=xxxxxxxxxxxxxxxx
AIRTEL_ENVIRONMENT=sandbox
AIRTEL_PIN=xxxx

# --- Orange Money ---
ORANGE_CLIENT_ID=xxxxxxxxxxxxxxxx
ORANGE_CLIENT_SECRET=xxxxxxxxxxxxxxxx
ORANGE_ENVIRONMENT=sandbox

# --- Wave ---
WAVE_API_KEY=xxxxxxxxxxxxxxxx
WAVE_ENVIRONMENT=test

# --- Exchange Rates ---
EXCHANGE_RATE_API_KEY=xxxxxxxxxxxxxxxx
EXCHANGE_RATE_PROVIDER=open-exchange-rates

# --- SMTP (Notifications) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@afripay.dev
SMTP_PASS=xxxxxxxxxxxxxxxx
NOTIFICATION_EMAIL_FROM=noreply@afripay.dev

# --- SMS ---
SMS_PROVIDER=twilio
SMS_PROVIDER_API_KEY=xxxxxxxxxxxxxxxx
SMS_FROM_NUMBER=+15551234567

# --- Encryption (for sensitive provider credentials in DB) ---
ENCRYPTION_KEY=change-me-to-a-32-char-string-for-aes-256

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Logging ---
LOG_LEVEL=info
